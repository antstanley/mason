{
	"name": "web",
	"private": true,
	"version": "0.7.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && tsc --noEmit -p tsconfig.json",
		"check:ci": "svelte-kit sync && tsc --noEmit -p tsconfig.json",
		"//check": "svelte-check crashes on typescript@7 (programmatic API stabilizes in TS 7.1, ~Oct 2026); swap check back to svelte-check then",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"lint": "oxlint src",
		"fmt": "oxfmt src",
		"fmt:check": "oxfmt --check src",
		"knip": "knip",
		"og": "node scripts/render-og.mjs",
		"icons": "node scripts/render-icons.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.1",
		"blogwright": "^0.3.3",
		"knip": "^6.29.0",
		"oxfmt": "^0.60.0",
		"oxlint": "^1.75.0",
		"playwright-core": "^1.62.0",
		"svelte": "^5.56.8",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"hls.js": "^1.6.16"
	}
}
